{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "@healthx/tokens",
  "version": "0.0.1",
  "tokens": {
    "color": {
      "brand": {
        "primary":              { "value": "hsl(217 78% 49%)", "$type": "color" },
        "primary-foreground":   { "value": "hsl(0 0% 100%)",   "$type": "color" }
      },
      "surface": {
        "background":           { "value": "hsl(0 0% 100%)",    "$type": "color" },
        "foreground":           { "value": "hsl(220 25% 13%)",  "$type": "color" },
        "muted":                { "value": "hsl(213 27% 96%)",  "$type": "color" },
        "muted-foreground":     { "value": "hsl(220 9% 46%)",   "$type": "color" },
        "card":                 { "value": "hsl(0 0% 100%)",    "$type": "color" },
        "card-foreground":      { "value": "hsl(220 25% 13%)",  "$type": "color" }
      },
      "line": {
        "border":               { "value": "hsl(220 13% 91%)",  "$type": "color" },
        "ring":                 { "value": "hsl(217 78% 49%)",  "$type": "color" }
      },
      "status": {
        "not-started":          { "value": "hsl(220 9% 60%)",   "$type": "color" },
        "running":              { "value": "hsl(217 91% 60%)",  "$type": "color" },
        "completed":            { "value": "hsl(142 71% 45%)",  "$type": "color" },
        "failed":               { "value": "hsl(0 84% 60%)",    "$type": "color" },
        "blocked":              { "value": "hsl(25 95% 53%)",   "$type": "color" },
        "partial":              { "value": "hsl(45 93% 47%)",   "$type": "color" },
        "waiting":              { "value": "hsl(25 95% 53%)",   "$type": "color" }
      }
    },
    "font": {
      "sans": { "value": "Geist, Inter, system-ui, -apple-system, BlinkMacSystemFont, sans-serif" },
      "mono": { "value": "Geist Mono, JetBrains Mono, ui-monospace, SFMono-Regular, monospace" }
    },
    "radius": {
      "default": { "value": "0.5rem" }
    }
  }
}
